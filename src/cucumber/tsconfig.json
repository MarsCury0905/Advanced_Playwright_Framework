{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020",
      "dom"
    ],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "../../dist/cucumber",
    "rootDir": "../..",
    "paths": {
      "@api/*": [
        "../../src/api/*"
      ],
      "@config/*": [
        "../../src/config/*"
      ],
      "@fixtures/*": [
        "../../src/fixtures/*"
      ],
      "@pages/*": [
        "../../src/pages/*"
      ],
      "@testdata/*": [
        "../../src/testdata/*"
      ],
      "@utils/*": [
        "../../src/utils/*"
      ]
    },
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}